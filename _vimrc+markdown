" ------------------------------------------------------------
" 图片配置
" ------------------------------------------------------------

" source 根目录的唯一标记文件
let g:blog_source_marker = 'dkx_img1.txt'

" 图片实际保存目录
let g:blog_image_dir = 'img'

" 图片文件名前缀
let g:mdip_imgname = 'image'


" ------------------------------------------------------------
" 查找 Hexo source 根目录
"
" 从当前 Markdown 所在目录开始向上寻找：
"
"     dkx_img1.txt
"
" 找到后，该目录就是 source。
" ------------------------------------------------------------

function! s:FindSourceRoot(file_dir) abort

    let current = fnamemodify(a:file_dir, ':p')

    while !empty(current)

        let marker = current . '/' . g:blog_source_marker

        if filereadable(marker)
            return current
        endif

        let parent = fnamemodify(current, ':h')

        if parent ==# current
            break
        endif

        let current = parent

    endwhile

    return ''

endfunction


" ------------------------------------------------------------
" 计算相对路径
"
" 例如：
"
" source/_posts/test.md
"     -> ../../img
"
" source/_posts/java/test.md
"     -> ../../../img
"
" source/_posts/java/game/test.md
"     -> ../../../../img
" ------------------------------------------------------------

function! s:GetRelativePath(from_dir, to_dir) abort

    let from_dir = fnamemodify(a:from_dir, ':p')
    let to_dir = fnamemodify(a:to_dir, ':p')

    " Windows 路径统一成 /
    let from_dir = substitute(from_dir, '\\', '/', 'g')
    let to_dir = substitute(to_dir, '\\', '/', 'g')

    " 去掉末尾 /
    let from_dir = substitute(from_dir, '/$', '', '')
    let to_dir = substitute(to_dir, '/$', '', '')

    let from_parts = split(from_dir, '/')
    let to_parts = split(to_dir, '/')

    let common = 0

    while common < len(from_parts)
        \ && common < len(to_parts)
        \ && from_parts[common] ==# to_parts[common]

        let common += 1

    endwhile

    let result = []

    " 从文章目录向上返回
    let i = common

    while i < len(from_parts)
        call add(result, '..')
        let i += 1
    endwhile

    " 从共同目录进入目标目录
    let i = common

    while i < len(to_parts)
        call add(result, to_parts[i])
        let i += 1
    endwhile

    return join(result, '/')

endfunction


" ------------------------------------------------------------
" Markdown 图片粘贴
" ------------------------------------------------------------

function! BlogPasteImage() abort

    " 当前 Markdown 文件
    let article_file = expand('%:p')

    if empty(article_file)

        echohl ErrorMsg
        echo '当前文件还没有保存，无法确定图片路径。'
        echohl None

        return

    endif


    " 当前文章目录
    let article_dir = fnamemodify(article_file, ':h')


    " --------------------------------------------------------
    " 查找 source
    " --------------------------------------------------------

    let source_root = s:FindSourceRoot(article_dir)

    if empty(source_root)

        echohl ErrorMsg
        echo '找不到 Hexo source 根目录。'
        echo '请确认 source 目录中存在：' . g:blog_source_marker
        echohl None

        return

    endif


    " --------------------------------------------------------
    " 实际图片目录
    "
    " Hexo/source/img
    " --------------------------------------------------------

    let image_dir = source_root . '/' . g:blog_image_dir

    " Windows 统一使用 /
    let image_dir = substitute(image_dir, '\\', '/', 'g')


    " --------------------------------------------------------
    " 自动创建 source/img
    " --------------------------------------------------------

    if !isdirectory(image_dir)

        call mkdir(image_dir, 'p')

    endif


    " --------------------------------------------------------
    " 计算 Markdown 中需要使用的相对路径
    " --------------------------------------------------------

    let relative_dir = s:GetRelativePath(
        \ article_dir,
        \ image_dir
        \ )


    " --------------------------------------------------------
    " 保存插件原配置
    " --------------------------------------------------------

    let old_imgdir = get(g:, 'mdip_imgdir', 'img')

    let old_imgdir_intext = get(
        \ g:,
        \ 'mdip_imgdir_intext',
        \ old_imgdir
        \ )

    let had_absolute = exists('g:mdip_imgdir_absolute')

    if had_absolute
        let old_imgdir_absolute = g:mdip_imgdir_absolute
    endif


    " --------------------------------------------------------
    " 临时设置 md-img-paste.vim
    "
    " 图片实际保存：
    "
    "     相对于文章目录的 relative_dir
    "
    " Markdown：
    "
    "     同样使用 relative_dir
    " --------------------------------------------------------

    let g:mdip_imgdir = relative_dir
    let g:mdip_imgdir_intext = relative_dir


    " 如果存在 absolute 模式，暂时关闭
    if exists('g:mdip_imgdir_absolute')
        unlet g:mdip_imgdir_absolute
    endif


    " --------------------------------------------------------
    " 调用 md-img-paste.vim
    " --------------------------------------------------------

    call mdip#MarkdownClipboardImage()


    " --------------------------------------------------------
    " 恢复插件原配置
    " --------------------------------------------------------

    let g:mdip_imgdir = old_imgdir
    let g:mdip_imgdir_intext = old_imgdir_intext

    if had_absolute
        let g:mdip_imgdir_absolute = old_imgdir_absolute
    endif

endfunction


