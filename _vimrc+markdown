" 创建 Markdown 表格
function! CreateMarkdownTable() abort

    let input = input('表格大小（行,列）: ')

    if input !~# '^\s*\d\+\s*[,，]\s*\d\+\s*$'
        echohl ErrorMsg
        echo '格式错误，请输入例如：3,3'
        echohl None
        return
    endif

    let parts = split(input, '[,，]')
    let rows = str2nr(parts[0])
    let cols = str2nr(parts[1])

    if rows < 1 || cols < 1
        echohl ErrorMsg
        echo '行数和列数必须大于 0'
        echohl None
        return
    endif

    let table = []


    " 第一行：表头
    let header = '|'

    for i in range(cols)
        let header .= ' <++> |'
    endfor

    call add(table, header)


    " Markdown 分隔线
    let separator = '|'

    for i in range(cols)
        let separator .= ' --- |'
    endfor

    call add(table, separator)


    " 剩余行
    for i in range(rows - 1)

        let line = '|'

        for j in range(cols)
            let line .= ' <++> |'
        endfor

        call add(table, line)

    endfor


    call append(line('.') - 1, table)

    " 光标移动到第一个 <++>
    normal! j

endfunction


" Space + tn：创建 Markdown 表格
nnoremap <Leader>tn :call CreateMarkdownTable()<CR>


" Space + tm：开关 Table Mode
