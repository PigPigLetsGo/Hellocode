"-----------------------------------------------------------------------
" 基础设置
" 请先搜索插件，安装必要插件比如：AceJump
"-----------------------------------------------------------------------

" 让 .ideavimrc 保存后自动重新加载
autocmd BufWritePost $MYVIMRC source $MYVIMRC

" 搜索高亮
set hlsearch

" 删除/退格行为
" IdeaVim 不支持 Vim 原生 backspace 选项，因此这里不设置

" Leader 键
let mapleader = " "

" 搜索相关
set incsearch
set ignorecase
set smartcase

" 历史记录
set history=3000000

" 相对行号
set number
set relativenumber

" 当前行
set cursorline

" 光标滚动时上下保留空间
set scrolloff=3

" 自动换行
set wrap

" 显示当前操作
set showcmd

" 显示模式
set showmode

" 匹配括号
" set showmatch


"-----------------------------------------------------------------------
" IdeaVim 功能
"-----------------------------------------------------------------------

set ideajoin
set exchange
set surround
set ideamarks
set commentary
set multiple-cursors

" IdeaVim 重构模式
set idearefactormode=keep

" IdeaVim 支持模式
" set ideavimsupport
set ideavimsupport=dialog

" IdeaVim 剪贴板
set clipboard=ideaput,unnamed

" 参数文本对象
let g:argtextobj_pairs="[:],(:),<:>"


"-----------------------------------------------------------------------
" Tab / 缩进
"-----------------------------------------------------------------------

" 注意：
" tabstop / shiftwidth / softtabstop 属于 Vim 原生选项，
" 当前 IdeaVim 环境不支持，因此删除。


"-----------------------------------------------------------------------
" 输入法
"-----------------------------------------------------------------------

" 回到 Normal 模式自动切换英文
set keep-english-in-normal

" 回到 Insert 模式时恢复之前输入法
set keep-english-in-normal-and-restore-in-insert


"=======================================================================
" 基础移动 / 搜索
"=======================================================================

" Leader + Enter：取消搜索高亮
noremap <LEADER><CR> :nohlsearch<CR>

" U / E：上下移动 3 行
noremap U 3kzz
noremap E 3jzz

" ESC：取消搜索并居中
nnoremap <Esc> :noh<CR>zz

" j / k：按屏幕行移动并居中
noremap j gjzz
noremap k gkzz

" N：下一个搜索结果并居中
noremap <S-n> <S-n>zz

" * / #：搜索当前单词并居中
noremap * *zz
noremap # #zz

" Ctrl-O / Ctrl-I：跳转历史位置并居中
noremap <C-o> <C-o>zz
noremap <C-i> <C-i>zz


"-----------------------------------------------------------------------
" 禁用 s
"-----------------------------------------------------------------------

map s <Nop>


"-----------------------------------------------------------------------
" 退出
"-----------------------------------------------------------------------

map <Leader>q :q!<CR>
map Q :qa!<CR>


"-----------------------------------------------------------------------
" Shift + Enter
"-----------------------------------------------------------------------

map <S-Enter> o<Esc>


